{
  "name": "life-launcher",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:windows:installer": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-installer.ps1",
    "package:windows:rc": "powershell -ExecutionPolicy Bypass -File scripts/prepare-release-candidate.ps1",
    "lint": "eslint . --ext ts,tsx --max-warnings=0",
    "format": "prettier --write .",
    "test:visual": "playwright test --grep-invert \"@manual\"",
    "test:public-safety": "node --test scripts/check-public-safety.test.mjs",
    "screenshot:public": "playwright test tests/visual/public-screenshots.spec.ts --grep \"@manual\"",
    "public:check": "node scripts/check-public-safety.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "dompurify": "3.4.17",
    "marked": "18.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.1.6"
  }
}
