{
  "name": "life-launcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:windows:installer": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-installer.ps1",
    "package:windows:rc": "powershell -ExecutionPolicy Bypass -File scripts/prepare-release-candidate.ps1",
    "lint": "set ESLINT_USE_FLAT_CONFIG=false&& eslint . --ext ts,tsx --max-warnings=0",
    "format": "prettier --write .",
    "test:visual": "playwright test",
    "screenshot:public": "playwright test tests/visual/public-screenshots.spec.ts",
    "public:check": "node scripts/check-public-safety.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "dompurify": "3.4.13",
    "marked": "18.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  }
}
